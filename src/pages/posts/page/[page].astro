---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import Pagination from '@/components/Pagination.astro';
import { getPosts } from '@/lib/posts';
import { SITE } from '@/site.config';

export async function getStaticPaths() {
  const allPosts = await getPosts();
  const totalPages = Math.max(1, Math.ceil(allPosts.length / SITE.postsPerPage));

  // Page 1 is handled by /posts/index.astro; start at page 2
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * SITE.postsPerPage;
    const end = start + SITE.postsPerPage;
    return {
      params: { page: String(page) },
      props: {
        currentPage: page,
        totalPages,
        pagePosts: allPosts.slice(start, end),
      },
    };
  });
}

interface Props {
  currentPage: number;
  totalPages: number;
  pagePosts: Awaited<ReturnType<typeof getPosts>>;
}

const { currentPage, totalPages, pagePosts } = Astro.props;

const prevUrl = currentPage === 2 ? '/posts/' : `/posts/page/${currentPage - 1}/`;
const nextUrl = currentPage < totalPages ? `/posts/page/${currentPage + 1}/` : undefined;
---

<BaseLayout
  title={`글 — ${currentPage}페이지`}
  description={SITE.description}
>
  <h1>글</h1>

  <PostList posts={pagePosts} />

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
  />
</BaseLayout>

<style>
  h1 {
    font-size: var(--step-2);
    margin-bottom: var(--space-4);
  }
</style>
