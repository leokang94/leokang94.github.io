---
import { tagUrl } from '@/lib/posts';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" role="list">
      {tags.map((tag) => (
        <li>
          <a href={tagUrl(tag)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .tag-list a {
    color: inherit;
    text-decoration: none;
  }

  .tag-list a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
</style>
